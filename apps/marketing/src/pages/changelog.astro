---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/astro/Header.astro';
import AnimatedGradientBackground from '../components/ui/animated-gradient-background';

/**
 * Hero images follow superset.sh: full content width, landscape, flush - no
 * border, no rounded corners, no shadow. Put files in `public/images/changelog/`
 * and set `image` to the public path; entries without one simply render none,
 * so nothing has to be invented to fill the slot.
 */
const releases: Array<{
  id: string;
  version: string;
  date: string;
  dateTime: string;
  title: string;
  prLinks: Array<{ pr: string; url: string }>;
  /** Optional hero image, rendered full-width and unstyled under the title. */
  image?: { src: string; alt: string };
  tldr: Array<{ bold: string; text: string }>;
  metricsTable?: { headers: string[]; rows: string[][] };
  sections: Array<{ heading: string; content: string }>;
}> = [
  {
    id: 'v1.3.3-monochrome-and-hosted-setup',
    version: 'v1.3.3',
    date: 'July 23, 2026',
    dateTime: '2026-07-23',
    title: 'Monochrome interface, agent-assisted setup, and a working hosted deploy',
    prLinks: [],
    tldr: [
      {
        bold: 'One monochrome system:',
        text: 'The landing page and setup flow drop every accent hue and read from the theme tokens, so light and dark both render correctly instead of white-on-white.'
      },
      {
        bold: 'Setup you can hand to an agent:',
        text: 'A copyable prompt installs the prerequisites, asks which port to use, starts the server and verifies it - alongside the manual commands.'
      },
      {
        bold: 'Failures that say what happened:',
        text: 'A boot error now renders an error with a reload button instead of a silent blank page, and a failed connection check answers in the transcript.'
      }
    ],
    sections: [
      {
        heading: 'Setup as a conversation',
        content: `Setup used to be two full-screen states swapping on a boolean, so a machine that was already connected never saw the instructions and a machine that connected mid-setup had the screen pulled out from under it. It is now a single transcript: the agent asks which platform you are on, hands over the commands, and announces the connection as a new message when it lands. Pressing "Check again" with nothing listening now gets a reply that escalates across attempts rather than repeating one line.`
      },
      {
        heading: 'Hosted deployment fixes',
        content: `The hosted build served its own bundle but rejected it: the CORS allowlist did not include the domain the server itself runs on, and module scripts marked crossorigin send an Origin header even same-origin, so every asset came back 500. The origin is now read from the platform environment. A refused origin also stops being reported as a 500 - an access decision is not a server fault, and the stack traces were flooding the log pipeline.`
      }
    ]
  },
  {
    id: 'v1.0.0-initial-release',
    version: 'v1.0.0',
    date: 'July 22, 2026',
    dateTime: '2026-07-22',
    title: 'Initial Release: Sui CLI Web - Built for First Movers',
    prLinks: [],
    tldr: [
      {
        bold: 'Keyboard-First Interface:',
        text: 'Built for speed with command palette navigation and a dense terminal aesthetic.'
      },
      {
        bold: 'Full Sui CLI Parity:',
        text: 'Address management, SUI transfers, coin splitting, and Move package execution.'
      },
      {
        bold: 'Keys Never Leave Your Machine:',
        text: 'The UI talks to a local server that shells out to the Sui CLI you already trust.'
      }
    ],
    sections: [
      {
        heading: 'Welcome to Sui CLI Web',
        content: `We launched Sui CLI Web to give Sui developers the interface the CLI deserves - the raw power of the Sui CLI behind a dense, keyboard-driven Web UI. Nothing is hosted on your behalf: the browser talks to a server running on your own machine, and your private keys stay in your local Sui config.`
      }
    ]
  }
];
---

<BaseLayout
  title="Changelog - What's New"
  description="The latest updates, performance improvements, and new features in Sui CLI Web. Updated regularly."
>
  <!-- Background Effect -->
  <div class="fixed inset-0 -z-10 pointer-events-none opacity-40">
    <AnimatedGradientBackground
      client:idle
      breathing={false}
      startingGap={125}
      breathingRange={5}
      animationSpeed={0.02}
      topOffset={0}
    />
  </div>

  <Header currentPath="/blog/changelog" />

  <main class="relative min-h-screen">
    <!-- Subtle Grid Lines -->
    <div
      class="absolute inset-0 pointer-events-none z-0"
      style="background-image: linear-gradient(to right, transparent 0%, transparent calc(50% - 384px), rgba(255,255,255,0.04) calc(50% - 384px), rgba(255,255,255,0.04) calc(50% - 383px), transparent calc(50% - 383px), transparent calc(50% + 383px), rgba(255,255,255,0.04) calc(50% + 383px), rgba(255,255,255,0.04) calc(50% + 384px), transparent calc(50% + 384px))"
    ></div>

    <!--
      Header, modelled on superset.sh/changelog: the word "Changelog" IS the
      heading rather than a small eyebrow above a decorative title, one line of
      orientation underneath, then the escape hatch to raw release notes. No
      panel, no border, no corner marks - the entries below carry the structure,
      so the header only needs to say where you are and get out of the way.
    -->
    <header class="relative">
      <div class="max-w-3xl mx-auto px-6 pt-20 pb-14">
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white">
          Changelog
        </h1>

        <p class="text-white/60 mt-4 text-base md:text-lg max-w-xl leading-relaxed">
          The latest updates, performance improvements, and feature additions in
          Sui CLI Web. Updated with every release.
        </p>

        <a
          href="https://github.com/hien-p/raycast-sui-cli/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 mt-6 text-sm text-white/70 hover:text-white transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>View releases on GitHub</span>
          <span class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </div>
    </header>

    <!-- Release Entries -->
    <div class="relative max-w-3xl mx-auto px-6 py-16">
      <div class="flex flex-col">
        {releases.map((release, i) => (
          <article
            id={release.id}
            class:list={['relative scroll-mt-24', i > 0 && 'border-t border-white/10 mt-20 pt-20']}
          >
            <!--
              The date leads each entry, as its own anchored heading. A changelog
              is read by "when did this land", so the date is the primary key -
              the version number is metadata about the date, not the other way
              round. The anchor makes every release directly linkable.
            -->
            <!--
              Date, version and PR refs all sit on one meta line above the title.
              They were previously split across the date line and a second row
              *between* the title and the body, which interrupted the read from
              headline into content with bookkeeping.
            -->
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-sm">
              <a href={`#${release.id}`} class="group inline-flex items-baseline gap-2">
                <time
                  datetime={release.dateTime}
                  class="text-white/60 group-hover:text-white transition-colors"
                >
                  {release.date}
                </time>
                <!--
                  select-none keeps the anchor marker out of copied text. Hiding
                  it with opacity alone still leaves it selectable, so copying a
                  release pasted a stray "#" on its own line.
                -->
                <span
                  class="select-none text-white/0 group-hover:text-white/40 transition-colors"
                  aria-hidden="true"
                >#</span>
              </a>

              <span class="select-none text-white/20" aria-hidden="true">·</span>

              <span class="text-white/50">{release.version}</span>

              {release.prLinks.map((pr) => (
                <a
                  href={pr.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white/30 hover:text-white transition-colors"
                >
                  #{pr.pr}
                </a>
              ))}
            </div>

            <h2 class="text-2xl md:text-[2rem] font-bold text-white leading-tight tracking-tight mt-2">
              {release.title}
            </h2>

            <!--
              Hero image, superset.sh treatment: straight below the title, full
              content width, landscape, and completely unstyled - no frame,
              radius or shadow, so a product screenshot reads as the product
              rather than as an illustration sitting on the page. Entries
              without an image render nothing here.
            -->
            {release.image && (
              <img
                src={release.image.src}
                alt={release.image.alt}
                width="1536"
                height="864"
                loading="lazy"
                decoding="async"
                class="mt-8 w-full h-auto"
              />
            )}

            <!-- Highlights -->
            <div class="mt-8">
              <h3 class="text-xs font-mono text-white/40 uppercase tracking-[0.14em]">Highlights</h3>
              <ul class="mt-3 space-y-2.5 text-sm md:text-base text-white/70">
                {release.tldr.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="text-white/25 mt-[0.45em] shrink-0 w-3 h-px bg-current" aria-hidden="true"></span>
                    <span>
                      <strong class="text-white font-medium">{item.bold}</strong> {item.text}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Metrics Table (if provided) -->
            {release.metricsTable && (
              <div class="mt-8 overflow-x-auto rounded-xl border border-white/10">
                <table class="w-full text-left text-sm font-mono">
                  <thead class="border-b border-white/10 text-white/40">
                    <tr>
                      {release.metricsTable.headers.map((header) => (
                        <th class="px-4 py-2.5 font-normal">{header}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-white/5 text-white/70">
                    {release.metricsTable.rows.map((row) => (
                      <tr>
                        <td class="px-4 py-2.5 text-white">{row[0]}</td>
                        <td class="px-4 py-2.5 text-white/40">{row[1]}</td>
                        <!-- The "after" column is the point of the table, so it
                             carries the emphasis that used to come from colour. -->
                        <td class="px-4 py-2.5 text-white font-semibold">{row[2]}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            <!-- Article Sections -->
            <div class="mt-8 space-y-7 text-white/70 leading-relaxed text-sm md:text-base">
              {release.sections.map((sec) => (
                <div>
                  <h3 class="text-base font-semibold text-white mb-2">{sec.heading}</h3>
                  <p>{sec.content}</p>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Bottom CTA Banner -->
    <section class="max-w-3xl mx-auto px-6 pb-24 text-center">
      <div class="p-8 rounded-2xl bg-black/70 border border-white/15 shadow-2xl relative overflow-hidden">
        <h2 class="text-2xl font-bold text-white mb-3 font-mono relative z-10">Start Building on Sui</h2>
        <p class="text-white/70 mb-6 max-w-md mx-auto text-sm relative z-10">
          Try the fastest keyboard-first web interface for Sui CLI today.
        </p>
        <div class="flex flex-wrap justify-center gap-4 relative z-10">
          <a
            href="https://cli.firstmovers.io"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 bg-white hover:bg-white/90 text-black font-bold rounded-lg font-mono text-sm transition-colors shadow-lg"
          >
            Launch Web App
          </a>
          <a
            href="https://github.com/hien-p/raycast-sui-cli"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-bold rounded-lg font-mono text-sm transition-colors border border-white/15"
          >
            GitHub Repo
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
